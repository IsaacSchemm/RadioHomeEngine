@model SiriusXMIndexModel
@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=0" />
    <title>Radio Home Engine - SiriusXM</title>
    @await Html.PartialAsync("_Styles")
    <style type="text/css">
            html, body {
                width: 100%;
                height: 100%;
                margin: 0;
            }

            body {
                display: flex;
                flex-direction: column;
            }

            input[type=number], button {
                line-height: 2em;
                margin: 0.5em;
                padding-left: 1em;
                padding-right: 1em;
            }
    </style>
</head>
<body>
    <section aria-label="Tuner" style="flex: 0 0 auto; display: flex; flex-direction: row">
        <div style="flex: 0 0 auto">
            <form asp-action="SetChannel" target="currentChannelFrame">
                <input type="number"
                       min="1"
                       max="@Model.Channels.Select(c => c.ChannelNumber).DefaultIfEmpty(1).Max()"
                       name="channelNumber"
                       value="@Model.ChannelNumber" />

                <button type="submit">Tune</button>
            </form>
        </div>

        <div style="flex: 1 1 auto"></div>

        <div style="flex: 0 0 auto">
            <form asp-action="ClearChannel" target="currentChannelFrame">
                <button type="submit">Untune</button>
            </form>
        </div>
    </section>

    <iframe name="audioFrame" src="/SXM/Player" style="border: 0; flex: 0 0 auto" height="80"></iframe>

    <iframe aria-label="Channel Information"
            name="currentChannelFrame"
            src="/SXM/ViewChannel"
            style="border: 0; flex: 1 1 auto"></iframe>
</body>
</html>
