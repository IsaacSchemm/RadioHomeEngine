@model SiriusXMIndexModel
@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=0" />
    <title>Radio Home Engine - SiriusXM</title>
    @await Html.PartialAsync("_Styles")
    <style type="text/css">
            html, body {
                width: 100%;
                height: 100%;
                margin: 0;
            }

            body {
                display: flex;
                flex-direction: column;
            }

            .pad {
                line-height: 2em;
                margin: 0.5em;
                padding-left: 1em;
                padding-right: 1em;
            }
    </style>
</head>
<body>
    <section aria-label="Tuner" style="flex: 0 0 auto; text-align: start">
        <form asp-action="SetChannel" style="display: inline" target="currentChannelFrame">
            <input type="number"
                    min="1"
                    max="@Model.Channels.Select(c => c.ChannelNumber).DefaultIfEmpty(1).Max()"
                    name="channelNumber"
                    value="@Model.ChannelNumber"
                    class="pad" />

            <button type="submit" class="pad">Tune</button>
        </form>

        <form asp-action="ClearChannel" style="display: inline" target="currentChannelFrame">
            <button type="submit" class="pad">Untune</button>
        </form>
    </section>

    <section aria-label="Devices" style="flex: 0 0 auto">
        <div>
            Play on:
        </div>

        <form asp-action="Player" method="get" style="display: inline" target="_blank">
            <button type="submit" class="pad">
                This device
            </button>
        </form>

        @foreach (var playerConnection in Model.Players)
        {
            <form asp-action="PlayOn" style="display: inline">
                <input type="hidden" name="macAddress" value="@playerConnection.MacAddress" />
                <button type="submit">
                    @playerConnection.Name
                </button>
            </form>
        }
    </section>

    @* <iframe name="audioFrame" src="/SXM/Player" style="border: 0; flex: 0 0 auto" height="80"></iframe> *@

    <iframe aria-label="Channel Information"
            name="currentChannelFrame"
            src="/SXM/ViewChannel"
            style="border: 0; flex: 1 1 auto"></iframe>
</body>
</html>
