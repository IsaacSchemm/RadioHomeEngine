@model SiriusXMIndexModel
@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=0" />
    <title>Radio Home Engine - SiriusXM</title>
    @await Html.PartialAsync("_Styles")
</head>
<body>
    <main>
        <form asp-action="SetChannel" target="currentChannelFrame">
            <input type="number" min="1" max="@Model.Channels.Select(c => c.ChannelNumber).DefaultIfEmpty(1).Max()" name="channelNumber" />
            <button type="submit">Play</button>
        </form>

        <form asp-action="ClearChannel" target="currentChannelFrame">
            <button type="submit">Stop</button>
        </form>

        <hr />

        <audio controls src="/Proxy/playlist-0.m3u8">
            HTML5 audio is not supported in this browser.
        </audio>

        <hr />

        <iframe name="currentChannelFrame" src="/SXM/CurrentChannel" height="300"></iframe>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/hls.js/1.5.18/hls.min.js"
            integrity="sha512-hARxLWym80kd0Bzl5/93OuW1ujaKfvmJ90yTKak/RB67JuNIjtErU2H7H3bteyfzMuqiSK0tXarT7eK6lEWBBA=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>

    <script type="text/javascript">
        if ("Hls" in window && Hls.isSupported()) {
            const audio = document.getElementsByTagName("audio")[0];

            audio.style.visibility = "hidden";

            const url = audio.src;

            const hls = new Hls({ startPosition: 0 });

            hls.on(Hls.Events.ERROR, function (event, data) {
                console.warn({ event, data });
            });

            hls.on(Hls.Events.MEDIA_ATTACHED, () => {
                hls.on(Hls.Events.MANIFEST_PARSED, () => {
                    audio.style.visibility = "visible";
                });

                hls.loadSource(url);
            });

            hls.attachMedia(audio);
        }
    </script>
</body>
</html>
