@model RadioIndexModel
@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=0" />
    <title>Radio Home Engine - Radio</title>
    @await Html.PartialAsync("_Styles")
    <style type="text/css">
        html, body {
            width: 100%;
            height: 100%;
            margin: 0;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        section {
            flex: 0 0 40px;
            margin: auto;
            width: min(100vw, 320px);
            display: flex;
            flex-direction: column;
        }

            section form {
                flex: 1 1 auto;
                display: flex;
                flex-direction: row;
                margin: 0.25em 0;
            }

                section form input,
                section form select {
                    flex: 1 1 auto;
                    margin-right: 0.5em;
                }
    </style>
</head>
<body>
    <section aria-label="Enter Channel">
        <form asp-action="ViewChannel" target="currentChannelFrame">
            <input type="number"
                   min="1"
                   max="@Model.Channels.Select(c => c.ChannelNumber).DefaultIfEmpty(1).Max()"
                   name="num"
                   value="" />

            <button type="submit" class="pad">View</button>
        </form>
    </section>

    <section aria-label="Choose Channel">
        <form asp-action="ViewChannel" target="currentChannelFrame">
            <select name="num">
                @foreach (var channel in Model.Channels)
                {
                    <option value="@channel.ChannelNumber">
                        @channel.ChannelNumber | @channel.ChannelInformation.ChannelName
                    </option>
                }
            </select>

            <button type="submit" class="pad">View</button>
        </form>
    </section>

    <iframe aria-label="Channel Information"
            name="currentChannelFrame"
            src="/Radio/ViewChannel?num=0"
            style="border: 0; flex: 1 1 auto"></iframe>
</body>
</html>
