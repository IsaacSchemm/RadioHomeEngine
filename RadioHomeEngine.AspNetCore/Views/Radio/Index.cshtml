@model RadioIndexModel
@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=0" />
    <title>Radio Home Engine - Radio</title>
    @await Html.PartialAsync("_Styles")
    <style type="text/css">
            html, body {
                width: 100%;
                height: 100%;
                margin: 0;
            }

            body {
                display: flex;
                flex-direction: column;
            }

            .pad {
                line-height: 2em;
                margin: 0.5em;
                padding-left: 1em;
                padding-right: 1em;
            }
    </style>
</head>
<body>
    <section aria-label="Enter Channel" style="flex: 0 0 auto; text-align: start">
        <form asp-action="ViewChannel" style="display: inline" target="currentChannelFrame">
            <select name="macAddress">
                <option></option>
                @foreach (var playerConnection in Model.Players)
                {
                    <option value="@playerConnection.MacAddress">
                        @playerConnection.Name
                    </option>
                }
            </select>

            <input type="number"
                   min="1"
                   max="@Model.Channels.Select(c => c.channelNumber).DefaultIfEmpty(1).Max()"
                   name="num"
                   value=""
                   class="pad" />

            <button type="submit" class="pad">View</button>

            <button asp-action="PlayOn" type="submit" class="pad">Play on selected device</button>
        </form>
    </section>

    <section aria-label="Choose Channel" style="flex: 0 0 auto; text-align: start">
        <form asp-action="ViewChannel" style="display: inline" target="currentChannelFrame">
            <select name="macAddress">
                <option></option>
                @foreach (var playerConnection in Model.Players)
                {
                    <option value="@playerConnection.MacAddress">
                        @playerConnection.Name
                    </option>
                }
            </select>

            <select name="num">
                @foreach (var channel in Model.Channels)
                {
                    <option value="@channel.channelNumber">
                        @channel.channelNumber | @channel.channelName
                    </option>
                }
            </select>

            <button type="submit" class="pad">View</button>

            <button asp-action="PlayOn" type="submit" class="pad">Play on selected device</button>
        </form>
    </section>

    <iframe aria-label="Channel Information"
            name="currentChannelFrame"
            src="/SXM/ViewChannel"
            style="border: 0; flex: 1 1 auto"></iframe>
</body>
</html>
