@model NowPlayingModel
@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=0" />
    <title>@Model.Channel.ChannelInformation.ChannelName - Now Playing</title>
    @await Html.PartialAsync("_Styles")
</head>
<body>
    <div id="channel">
        <div style="font-size: 200%">
            @Model.Channel.ChannelNumber
        </div>

        <div>
            @Model.Channel.ChannelInformation.ChannelName
        </div>

        @foreach (var description in Model.Channel.ChannelInformation.ChannelDescriptions)
        {
            <div style="font-size: 75%">
                @description
            </div>
        }
        </div>

    <hr />

    <audio controls src="/SXM/PlayChannel?num=@Model.Channel.ChannelNumber">
        HTML5 audio is not supported in this browser.
    </audio>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/hls.js/1.5.18/hls.min.js"
            integrity="sha512-hARxLWym80kd0Bzl5/93OuW1ujaKfvmJ90yTKak/RB67JuNIjtErU2H7H3bteyfzMuqiSK0tXarT7eK6lEWBBA=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>

    <script type="text/javascript">
        if ("Hls" in window && Hls.isSupported()) {
            const audio = document.getElementsByTagName("audio")[0];

            audio.style.visibility = "hidden";

            const url = audio.src;

            const hls = new Hls({ startPosition: 0 });

            hls.on(Hls.Events.ERROR, function (event, data) {
                console.warn({ event, data });
            });

            hls.on(Hls.Events.MEDIA_ATTACHED, () => {
                hls.on(Hls.Events.MANIFEST_PARSED, () => {
                    audio.style.visibility = "visible";
                });

                hls.loadSource(url);
            });

            hls.attachMedia(audio);
        }
    </script>

    @if (Model.ProgramInformation is ProgramInformation programInformation)
    {
        <hr />

            @if (programInformation.Program is Program.Song song)
            {
                if (song.Item.Images.FirstOrDefault() is string imageUrl)
                {
                    <div>
                        <img src="@imageUrl" alt="" width="225" height="225" style="object-fit: contain" />
                    </div>
                }

                <div style="font-size: 125%; margin: 0.5em 0">
                    @song.Item.Title
                </div>

                <div>
                    @string.Join(" / ", song.Item.Artists)
                </div>

                <div style="font-size: 75%">
                    @string.Join(" / ", song.Item.Albums)
                </div>
            }
            else
            {
                <div style="font-size: 125%; margin: 0.5em 0">
                    @programInformation.ProgramName
                </div>
            }
        }
</body>
</html>
